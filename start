#!/usr/bin/env bash

# Create a temporary file to keep track of PID_A across subshells
PID_A_FILE=$(mktemp)

echo 0 >"$PID_A_FILE"
lastActive=0

# 2. Start the Hyprland socket listener in the background
socat -U - UNIX-CONNECT:"$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" | while read -r line; do
  if [[ "$line" == *"activewindow"* ]]; then
    active=$(hyprctl activewindow -j | jq -r .class)

    if [[ "$active" == "mathbreakers.exe" ]]; then
      if [[ $lastActive == 0 ]]; then
        hyprctl dispatch 'hl.dsp.window.tag({ tag = "-math_hide", window = "class:^Mathbreakers$" })'
        lastActive=1
        keyModifier --modify space turbo downFor 20ms delay 20ms --modify space maxPressTime 350ms --modify e replace r &>/dev/null &
        # Write the new PID to the file so the main script/cleanup can see it
        id=$(cat "$PID_A_FILE")
        if [[ "$id" != 0 ]]; then
          kill "$id" 2>/dev/null
        fi
        echo $! >"$PID_A_FILE"
      fi
    else
      if [[ $lastActive == 1 ]]; then
        hyprctl dispatch 'hl.dsp.window.tag({ tag = "+math_hide", window = "class:^Mathbreakers$" })'
        lastActive=0
        # Read the current PID from the file and kill it
        kill "$(cat "$PID_A_FILE")" 2>/dev/null
      fi
    fi
  fi
done &>/dev/null &
PID_S=$!

# 3. Launch your application in kitty
kitty --class Mathbreakers -c /dev/null go run . "$@" &
PID_D=$!

# 4. Cleanup function
cleanup() {
  echo "Cleaning up background tasks..."
  # Read the latest PID from the file to kill it
  if [[ -f "$PID_A_FILE" ]]; then
    id=$(cat "$PID_A_FILE")
    if [[ "$id" != 0 ]]; then
      kill "$id" 2>/dev/null
    fi
    rm -f "$PID_A_FILE"
  fi
  kill "$PID_S" 2>/dev/null
  kill "$PID_D" 2>/dev/null
}

trap cleanup EXIT
wait
